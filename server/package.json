{
  "name": "nove-server",
  "version": "3.2.0-ext",
  "description": "Nove v3.2.0-ext server (Express + Firebase Admin)",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node index-extended.js",
