# Nove server — environment template
NODE_ENV=production
PORT=3000
FILES_DIR=/var/files

# Encryption key (32-byte hex). Render auto-generates this on first deploy.
ENCRYPTION_KEY=

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=https://nove-dashboard.onrender.com

# Firebase Admin — from Firebase Console → Project settings → Service accounts
FIREBASE_DATABASE_URL=https://nove33-a56e7-default-rtdb.europe-west1.firebasedatabase.app
FIREBASE_SERVICE_ACCOUNT_JSON=
