FROM node:20-alpine AS build
WORKDIR /app
COPY dashboard/package.json dashboard/package-lock.json* ./
RUN npm install
COPY dashboard/ ./
ARG VITE_FIREBASE_API_KEY=__set_me__
ARG VITE_FIREBASE_AUTH_DOMAIN=__set_me__
ARG VITE_FIREBASE_PROJECT_ID=__set_me__
ARG VITE_FIREBASE_STORAGE_BUCKET=__set_me__
ARG VITE_FIREBASE_MESSAGING_SENDER_ID=__set_me__
ARG VITE_FIREBASE_APP_ID=__set_me__
RUN npm run build
FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
